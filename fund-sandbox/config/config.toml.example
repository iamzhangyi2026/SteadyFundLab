# ============================================================================
# config.toml.example —— 配置模板
#
# 用法：复制为 config.toml 后按需修改。
#   cp config/config.toml.example config/config.toml
#
# config.toml 已被 .gitignore 忽略，不会上传；本模板不含任何密钥 ——
# API key 运行时写入 data/llm_pool.json。
# ============================================================================

# ==============================================================================
# fund-sandbox 主配置文件
#
# 设计原则：
#   1. 凡是"规则"，都必须写明依据（法规 / 平台规则 / 用户约定），不写无来源的数字
#   2. 凡是"可调"，都集中在这里，不要在代码里散落魔数
#   3. 修改本文件后需要重启服务才会生效（除 boards.json 外）
# ==============================================================================

[project]
name = "fund-sandbox"
# 一句话定位：用虚拟资金、真实规则验证基金交易策略的沙盒
# 定位：AI 主导的试验场，用虚拟资金验证策略
# 产出的分析供人参考，真实资金操作在本系统之外
description = "虚拟资金 + 真实规则的基金交易沙盒，AI 主导执行，人负责总控"

# ==============================================================================
# 资金规则
#
# 口径：
#   可用预算 = 初始资金 + 历史累积新增 − 已用金额 + 投资收益
#   投资收益 = 累计赎回金额 + 累计分红 − 累计申购金额（可为负）
#
# 两个容易搞错的点：
#   1. **累积制，不是每月清零**。每月新增 1000 是往池子里累加，
#      不是「当月不用就作废」。所以第二个月可用 = 1000 + 2000 − 已用 + 收益。
#   2. **盈亏会反过来影响可用预算**。赚到的钱可以继续投，亏掉的钱会削减预算。
#      这是复利逻辑，不是固定额度。
#
# 会计上的等价关系（实现时用它做校验）：
#   可用预算 ≡ 现金余额 = 初始 + 累积新增 − 累计申购 + 累计赎回 + 累计分红
#   因为「已用金额」= 当前仍持仓的成本，「投资收益」= 已实现盈亏，
#   两者一减一加后与现金流水口径完全相等。
# ==============================================================================
[capital]
# 初始资金
initial_cash = 1000.0

# 每月新增预算（累积，不清零）
monthly_quota = 1000.0

# 单只基金每周定投额 = 25 元/周 = 100 元/月
per_fund_weekly = 25.0

# 正式启动月：此月之前不入账任何资金（测试期数据应已清空）。
# 到达该月首次打开 app 时自动入 initial_cash 作为正式初始资金，
# 之后每月累加 monthly_quota（月累计制，不清零）。
official_start_month = "2026-09"

# 三个用途共享同一个池子，不是各自独立额度：
#   1. 定投（每只固定 per_fund_weekly 元/周）
#   2. 灵活加仓（金额**不固定**，完全由分析结果决定）
#   3. 开新仓（可选灵活买入 / 定投买入 / 两者组合）
#
# 加仓金额不设档位、不设上限表：唯一硬约束是不超过可用预算（real constraint）。
# （原 flexible_add_tiers 键从未被代码或界面读取，属"看着可调实则无效"，已删除。）

# ==============================================================================
# 决策源
# 只有一种：AI（接管 agent）亲自决策。系统不做规则/模型兜底
# ==============================================================================
[decision]
# 系统只有一种决策方式：**AI（接管 agent）亲自决策**。
# 定时 automation 唤醒后，读取数据、分析，再调用 POST /api/order
# （decision_source="external"）+ 必填理由下达。定投按纪律自动执行。
#
# **没有兜底**：不存在「AI 离线 → 规则引擎接管自主交易」或「内置 LLM 代决策」
# 这类自动降级。规则只做数据计算与风控边界，不替 AI 做买卖决定；
# AI 不在时系统就等着，只在界面上亮出离线状态。

# 心跳超时（小时）。AI 每次参与运作会刷新心跳时间戳，
# 超过这个时长没有新心跳 → 界面显示「AI 离线」（只亮状态，不触发任何自动动作）。
heartbeat_timeout_hours = 6

# 服务监听地址。只绑回环地址，不对外暴露，保证数据不出本机
host = "127.0.0.1"
port = 8765

# 常驻调度：软件打开即后台运行，无需人工干预
[runtime]
# 交易时段内的巡检间隔（分钟）：检查纪律线、罚期到期、风控
intraday_check_minutes = 30
# 启动时是否立即刷新一次（避免隔夜数据陈旧）
refresh_on_startup = true
# 心跳文件路径。AI 与规则引擎靠这个文件协调
heartbeat_file = "data/heartbeat.json"
# 注：每日刷新时刻统一由 [schedule] daily_refresh_time 控制
# （原 [runtime] daily_refresh_time 与之重复且从未被读取，已删除，避免"改了这个没用"）。

# ==============================================================================
# 风控边界（**AI 自设的风控参数**）
#
# 这些是接管 AI 为约束自身交易行为而设的纪律上限，**不是用户下达的要求，
# 也不是真实世界的监管/渠道规则**；可调、可撤 —— 改这里＝改 AI 自己的风控松紧。
# 执行方式：**纯提醒、不拦截**（风控边界只是警告，照常下单，
# 是否收敛由 AI 自己判断）。
# ==============================================================================
[risk]
# 单只基金占持仓市值的上限（%）—— AI 自设：防单押
max_single_position_pct = 25.0
# 单日下单次数上限 —— AI 自设：防高频乱动
max_orders_per_day = 10
# 单笔金额上限（元）—— AI 自设：防单笔过重
max_amount_per_order = 500.0
# 账户最大回撤止损线（%），触及仅告警、不自动清仓 —— AI 自设
max_drawdown_stop_pct = 20.0
# 注：急停（emergency stop）功能已停用（auto_resume_after_stop 键一并删除）。

# ==============================================================================
# 纪律线（策略阈值）
#
# 属**策略参数**（人定的交易纪律），不是法规常量，也不是市场事实 ——
# 所以必须可调：改这里就是改纪律，不需要动代码。
# ==============================================================================
[rules]
# 止盈兑现：浮盈达到该比例 → 减仓
profit_take_pct = 20.0
# 回撤减仓：从近期高点回撤该比例 → 减仓
drawdown_cut_pct = 15.0
# 认错清仓：亏损达到该比例且跑输基准 → 清仓（负值）
stop_loss_pct = -5.0
# 计算「近期高点」的回看天数
lookback_days = 60

# ==============================================================================
# 持仓健康度引擎（六维打分 0~100 + 分级处置）
#
# 权重合计 100；分级阈值由高到低。
# 「持续性门槛」是"不直接卖掉"的机制保证：分数低还要**连续 N 天**才升档，
# 单日异常最多到 watch —— 这是与"一跌就卖"最本质的区别，改小它等于削弱保护。
# ==============================================================================
[health]
# 六维权重（合计 100）
weight_trend = 25.0
weight_persist = 20.0
weight_relative = 15.0
weight_drawdown = 15.0
weight_valuation = 10.0
weight_news = 15.0

# 分级阈值（分）
level_healthy = 70.0   # ≥70 健康
level_watch = 55.0     # 55~70 关注
level_alert = 35.0     # 35~55 预警（候选减仓）

# 持续性门槛（天）：低于阈值需连续多少天才允许升级到对应处置
persist_days_for_reduce = 2
persist_days_for_clear = 3
# 连续预警多少天把「持续性」这一维扣到 0 分
persist_full_penalty = 5
# 判定「预警态」的分数线
alert_score = 60.0

# 观察窗口
win_short = 20         # 短期动量（交易日）
win_mid = 60           # 中期动量 / 近期高点 / 均线
win_valuation = 250    # 估值分位回看天数（交易日）
news_window_days = 7   # 舆情回看天数

# ==============================================================================
# 费率规则
# 来源：支付宝（蚂蚁财富）实际规则 + 证监会《公开募集证券投资基金运作管理办法》
#
# 重要：管理费与托管费已经在净值中每日计提扣除，本系统绝不重复计算。
# 这里只算交易成本：申购费 + 赎回费。
# ==============================================================================
[fee]
# 申购费折扣。支付宝是"部分基金 1.25 折起"，不是全部 1 折，
# 因此实际申购费 = 基金原始申购费率 × discount，逐只按实际费率算，不写死 0.15%
purchase_discount = 0.125

# 申购费**兜底**原始费率：仅当该基金的费率字段取不到时使用。
# 品类间差异很大（股票型/混合型约 1.5%，债券型 0.6%~0.8%），
# 所以正常路径一律用逐只抓来的真实费率，这里只是一个有据可查的缺省值，
# 而不是"所有基金都 1.5%"。
default_purchase_fee_rate = 0.015

# 赎回费阶梯，按持有天数分档。
# 依据：证监会规定 + 支付宝页面公示的标准阶梯，各渠道执行同一标准
# 判定顺序：从上往下，命中第一条即返回
#
# penalty = true 标记**罚期档**：该档的 max_holding_days 即「免罚门槛」，
# 代码里所有「还需几天免罚」「是否踩罚费」都从这一处派生（不再散落写死 7）。
[[fee.redeem_tiers]]
max_holding_days = 7
rate = 0.015
penalty = true
note = "惩罚性赎回费。持有不满 7 天强制收取，全行业统一，不因渠道而异"

[[fee.redeem_tiers]]
max_holding_days = 30
rate = 0.0075
note = "7 天（含）到 30 天"

[[fee.redeem_tiers]]
max_holding_days = 365
rate = 0.005
note = "30 天（含）到 1 年"

[[fee.redeem_tiers]]
max_holding_days = 730
rate = 0.0025
note = "1 年（含）到 2 年"

[[fee.redeem_tiers]]
max_holding_days = 999999
rate = 0.0
note = "满 2 年以上，多数基金免收（以基金合同为准）"

# ==============================================================================
# 交易规则（真实世界约束）
# ==============================================================================
[trading]
# 15:00 截单。15:00 前下单按 T 日净值，之后顺延到下一交易日
# （交易规则级不变量，与具体基金无关）
cutoff_time = "15:00"

# 份额确认延迟（交易日）。按品类不同——**不是一律 T+1**：
confirm_delay_days = 1          # 普通场外基金：T+1 确认份额
qdii_confirm_delay_days = 2     # QDII：跨境时差，T+2 确认份额

# 赎回资金**到账**延迟（交易日）。按品类差异很大，以基金合同为准。
# 按下列顺序匹配基金「类型」字段，命中即用；都没命中用 redeem_arrival_days 兜底。
# 赎回款到账前属**在途资金**，不能当作可用余额。
redeem_arrival_days = 3
[[trading.redeem_arrival_rules]]
keyword = "货币"
days = 1
[[trading.redeem_arrival_rules]]
keyword = "债"
days = 2
[[trading.redeem_arrival_rules]]
keyword = "QDII"
days = 5
[[trading.redeem_arrival_rules]]
keyword = "海外"
days = 5
# 注：QDII 净值本身的 T+2 滞后由数据源自带的 nav_date 体现（按日期对齐即可），
# 不是一个可配天数；原 qdii_lag_days 键从未被读取，已删除。

# ==============================================================================
# 候选池（原「交易池」）基础种子
# 留空：候选池不再由配置硬编码种子，改为「全市场筛选 → AI/用户按需添加」，
# 契合项目目的（找估值洼地 + 趋势向上的基金；范围 = 全基金池，非固定板块）。
# 任何添加都须填写 reason（为什么添加），落库 funds.add_reason，前端候选列表展示。
# ==============================================================================

# ==============================================================================
# 数据质量规则
# 来源：实战中踩过的坑，逐条对应防范措施
# ==============================================================================
[data_quality]
# 净值合理性闸门：区间外的数据一律拒收，物理拦截脏数据
nav_min = 0.01
nav_max = 1000.0

# 双源交叉容差。对齐日期后 |Δ| 超过该比例即标 VERIFY，不硬编
cross_tolerance_pct = 1.0
# 注：三源裁决（arbitration）尚未实现——双源不一致时当前一律标 VERIFY、交人工/AI 定性。
# 原 arbitration_threshold_pct 描述的是没落地的机制，已删除（不留"看着能配、实则无效"的键）。

# 净值停滞检测：连续 N 天完全一致视为接口未更新（可能是静默失败）
stale_nav_days = 3

# 单日净值跳变阈值（%），超过则进入异常清单待 AI 定性
# 注意：分红除息会造成净值跳变，这是真实事件不是脏数据，需要 AI 区分
nav_jump_threshold_pct = 10.0

# 长周期统计排序陷阱（**代码约定，不是可调参数**）：
# akshare 的 kline 默认按日期降序返回，做中长期统计必须先按日期显式排序，
# 禁止直接取 r[0]/r[-1] 当起止。
# 历史教训：某基金 5 年收益因此从 -20.2% 被算成 +25.4%
# （原 always_sort_by_date 布尔键从未被读取，是"约定写成开关"，已删除，保留本说明）

# 分红自动识别阈值（单位净值变动与累计净值变动的差，单位：百分点）
# 原理：分红除息时单位净值下调，但累计净值把分红加回去了，两者会拉开差距。
# 实测：270042 在 2016-02-22 单位净值 -15.74% 而累计净值 +1.45%，差 17 个百分点。
# 真实市场波动下两者同步（差值接近 0），所以 3 个百分点足以区分。
dividend_gap_pct = 3.0

# ==============================================================================
# 数据源配置
# 数据主源 / 备用源目前硬编码在 backend/data/fetcher.py（如 em_lsjz / em_fund_info /
# em_board），按「主源失效自动切换备用源并记健康度」策略工作；此处不再重复声明，
# 避免配置看着像生效、实际不被读取的漂移。
# ==============================================================================

# ==============================================================================
# 定时任务
# ==============================================================================
[schedule]
# 每日收盘后执行全量刷新（此时当日净值已披露）
daily_refresh_time = "20:00"
# 时区：系统运行在用户本机（中国），交易日/截单时刻一律按**本机时区**计算，
# 不引入可配时区，以免配置值与系统时钟不一致造成"看似上海、实则别的时区"。
# （原 timezone 键从未被读取，已删除。）

# ==============================================================================
# 可投资范围
#
# 只买**场外**基金——不需要注册股票账户、在支付宝/天天基金就能直接买的品类。
# 场内 ETF、REITs 之类需要股票账户，不在本系统范围内。
#
# 注意 ETF 这个坑：
#   「XX ETF 联接」是场外 feeder fund，可以直接定投，属于可买范围；
#   「XX ETF」本身是场内品种，需要股票账户，不能买。
#   两者名字只差两个字，必须靠类型字段区分，不能只看名称。
# ==============================================================================
[universe]
allowed_types = ["ETF联接", "LOF", "QDII", "混合型", "股票型", "指数型", "债券型"]

# 明确禁止的品类
# 注意：forbidden 只匹配「基金类型字段」，本系统只搜索公募基金，不会传入个股，
# 因此这里不写「股票」——否则会把「指数型-股票」「股票型」这类合法场外基金也误杀。
# 真正需要股票账户的是场内 ETF（由 ambiguous 关键词 +「无联接」逻辑拦截）。
forbidden_types = ["场内ETF", "REITs", "私募", "资管计划"]

# 名称含这些关键词时，必须校验类型字段确认是场外还是场内，
# 不能仅凭名称放行
ambiguous_keywords = ["ETF"]

# ==============================================================================
# 持仓穿透分析
#
# 为什么不能只看基金名称：风格漂移很常见。
# 名为「XX新兴成长」的基金可能重仓银行股，名为「XX消费」的可能满仓新能源。
# 只有穿透到实际持仓，才知道钱真正压在哪些行业上——
# 这直接决定「行业暴露度」「同涨同跌集中度」是不是真的分散。
# ==============================================================================
[analysis]
# 穿透分析取前几大重仓股
holdings_top_n = 10

# 两只基金前十大重仓股重叠达到几只，判定为「重复暴露」（假分散）
overlap_warn_count = 3

# 单一行业占基金净值超过该比例，判定为「行业集中」
concentration_warn_pct = 50.0

# 名称宣称方向与实际持仓不符时，漂移度超过该比例则告警
drift_warn_pct = 50.0

# 名称关键词与行业的映射表。用于检测「名不副实」。
# 例：名称含"消费"但实际持仓里消费行业占比很低 → 标记漂移
name_industry_hints = [
    { keywords = ["消费", "内需"], industry = "消费" },
    { keywords = ["医药", "医疗", "生物"], industry = "医药" },
    { keywords = ["科技", "创新", "成长", "新兴"], industry = "科技" },
    { keywords = ["新能源", "光伏", "锂电"], industry = "新能源" },
    { keywords = ["半导体", "芯片", "集成电路"], industry = "半导体" },
    { keywords = ["军工", "国防", "安全"], industry = "军工" },
    { keywords = ["金融", "银行", "证券"], industry = "金融" },
    { keywords = ["农业", "食品", "白酒"], industry = "农业食品" },
]

# ==============================================================================
# 恢复机制（备份与恢复）
#
# 运营库历史上被整体重置清空过，重置后历史全丢。恢复机制分两层：
#   1) 全量快照：每日自动复制一份运营库（gzip 压缩）作为「近期一键可恢复副本」；
#   2) 归档库 corpus.db：长期增量历史，重置后可按表回灌运营库。
#
# 空间原则：允许全量备份，但旧快照必须滚动清理——
# 恢复通常只需近期一份，历史全量纯占空间，不做无脑堆积。
# ==============================================================================
[backup]
# 最多保留几份快照（超出部分按时间从旧到新删除）
keep_snapshots = 7
# 快照最多保留几天（超期即删，与 keep_snapshots 取更严格者）
keep_days = 7
# 是否 gzip 压缩（运营库约 10MB，压缩后约 2~3MB，强烈建议开）
compress = true
